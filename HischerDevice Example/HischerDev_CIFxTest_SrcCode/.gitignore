# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific folders
/.vs/

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/

# Uncomment if you have tasks that create the project's nuget packages in these folders
# [Nn]upkg/

# Uncomment if you have tasks that create Symbol or NuGet package output in these folders
# [Pp]ackage/

# msbuild generated project files
.vcxproj*
.vcxproj.*.user
*.msbuild.*.cache
*.msbuild.*.3.binlog
*.ipch
*.tlog
*.lastbuildstate
*.idb
*.pdb
*.opencover.*
*.profraw
*.cppcheck

# Uncomment if you have tasks that create Visual Studio Code workspace files
# .vscode/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Visual Studio profiler files
*.psess
*.vsp
*.vspx

# NUnit
*.VisualState.xml
TestResult.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# DNX
project.lock.json
project.fragment.lock.json
artifacts/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Entity Framework
*.edmx
*.tt
*.jj

# RIA/Silverlight projects
Generated_Code/

# Backup & report files from converting an old project file
# to a newer Visual Studio version
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQLite files
*.db

# LightSwitch generated files
GeneratedArtifacts/
_Pvt_Extensions/

# MSTest test Results
[TestResults]/

# Build Logs
*.log

# Code coverage results
*.coverage
*.coveragexml

# nCrunch
_nCrunch_*
.*crunch*.local.xml

# chutzpah
_Chutzpah*

# VsCode config
.vscode/

# Node.js Tools for Visual Studio
.ntvs_analysis.dat
node_modules/
npm-debug.log

# Yarn
.yarn-debug.log
.yarn-error.log

# Windows Store app package directories and files
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
.vsappx
# Local History for Visual Studio
.localhistory/

# Visual Studio 2019 (v16.x) and newer
.vscode/
.vscode/tasks.json
.vscode/launch.json
.vscode/extensions.json
.vscode/settings.json
.vscode/c_cpp_properties.json

# CMake generated files
CMakeSettings.json
CMakeLists.txt.user

# JetBrains Rider
.idea/
.idea/.idea.dataSources/
.idea/.idea.dataSources.local/
.idea/.idea.dataSources.xml
.idea/.idea.dataSources.ids
.idea/.idea.grazie/
.idea/.idea.sharedIndexes/
.idea/.idea.docker/
.idea/.idea.workspace.xml
.idea/.idea.misc.xml
.idea/.idea.modules.xml
.idea/.idea.project.attributions.xml
.idea/.idea.modules.xml
.idea/.idea.project.files.xml
.idea/.idea.project.files.indexed.xml
.idea/.idea.project.xml

