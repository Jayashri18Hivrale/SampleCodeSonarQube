def build(bld):
    
    includes = ["."]
    
    bld.sdkcomponent(
        name            = "netx_drv_configuration_sdk",
        export_includes  = includes,
        )
    
    bld.sdkcomponent(
        name            = "nx90_pns_config_sdk",
        export_defines  = [
                           "PNS_APIS = 1",
                           "PNS_INPUT_SUBMODULES =  1",
                           "PNS_IN_OUT_SUBMODULES =  0",
                           "PNS_OUTPUT_SUBMODULES =  1",
                           ],
        )
    
    bld.sdkcomponent(
        name            = "dModules_configuration_sdk",
        export_includes  = includes,
        )