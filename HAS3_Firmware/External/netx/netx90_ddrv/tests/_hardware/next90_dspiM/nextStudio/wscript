def get_library_build_paths(base_path):
    """
    Search for valid folders containing a `wscript` file.
    - If the folder `build` exists:
        - Check for `build/wscript`.
        - If not found, check for `build/waf/wscript`.
    - Return a list of folders containing valid `wscript`.
    """
    valid_folders = []
    for root, dirs, files in os.walk(base_path):
        # Look for the `build` folder
        if "build" in dirs:
            build_path = os.path.join(root, "build")

            # Check for `build/wscript`
            build_wscript = os.path.join(build_path, "wscript")
            if os.path.isfile(build_wscript):
                valid_folders.append(build_path)
                continue  # Move to the next folder after saving `build`

            # Check for `build/waf/wscript`
            waf_path = os.path.join(build_path, "waf")
            waf_wscript = os.path.join(waf_path, "wscript")
            if os.path.isdir(waf_path) and os.path.isfile(waf_wscript):
                valid_folders.append(waf_path)
    return valid_folders

